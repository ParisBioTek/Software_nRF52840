#include <dt-bindings/adc/nrf-adc.h>

/ {
    chosen {
        zephyr,uart-mcumgr = &cdc_acm_uart0;
        zephyr,console     = &cdc_acm_uart0;
    };

    /*
     * GPIO P0.08 : OE de l'oscillateur actif 32 MHz OSC1 du nRF52840.
     * Il doit rester HIGH : USB/BLE peut demander HFCLK à tout instant ; le
     * forcer LOW fige le CPU/USBD alors que le port COM reste encore énuméré.
     * Référencé via l'alias "hfxo-enable" dans power_manager.c.
     */
    /* Nœud volontairement neutre : ces lignes sont des commandes de carte,
     * pas des LED. Elles ne doivent jamais être revendiquées par le pilote LED. */
    pbt_control_gpios {
        compatible = "pbt,control-gpios";
        hfxo_en: hfxo_en {
            gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
        };
        /* AD5940 : CS P0.17 (actif bas), RST P0.20 (actif bas), alim P1.00 */
        ad5940_cs: ad5940_cs {
            gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
        };
        ad5940_rst: ad5940_rst {
            gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
        };
        sensor_pwr: sensor_pwr {
            gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
        };
    };

    aliases {
        hfxo-enable  = &hfxo_en;
        ad5940-cs    = &ad5940_cs;
        ad5940-rst   = &ad5940_rst;
        sensor-power = &sensor_pwr;
    };

    /*
     * Canal ADC pour lecture du rail VDDH/VDD de cette carte.
     * Utilise VDDHDIV5 (entrée interne nRF52840 = VDDH/5) — aucun pin requis.
     */
    zephyr,user {
        io-channels = <&adc 0>;
    };
};

/* Canal logique SAADC 0 : entrée interne VDDHDIV5, aucun GPIO. */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain             = "ADC_GAIN_1_6";
        zephyr,reference        = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive   = <NRF_SAADC_VDDHDIV5>; /* VDDH/5 interne — aucun pin requis */
        zephyr,resolution       = <12>;
    };
};

&zephyr_udc0 {
    status = "okay";
    /* Port unique SMP : DFU mcumgr + commandes/données de mesure. Logs sur RTT. */
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/*
 * Le binaire utilise encore la cible Zephyr nrf52840dk/nrf52840, mais le PCB
 * PBT n'embarque aucun des périphériques Arduino/QSPI de la DK. Les laisser
 * actifs crée de vrais conflits de broches : le QSPI de la DK revendique
 * notamment P0.17/P0.20/P0.22 (CS/RESET/MOSI de l'AD5940) et l'UART0 P0.08
 * (commande de l'oscillateur externe). Le DFU passe par l'USB natif ci-dessus
 * et ne dépend d'aucun de ces blocs.
 */
&qspi  { status = "disabled"; };
&mx25r64 { status = "disabled"; };
&uart0 { status = "disabled"; };
&i2c0  { status = "disabled"; };
&pwm0  { status = "disabled"; };
&spi3  { status = "disabled"; };

/* Nœuds d'E/S purement DK : certains partagent SCLK/MISO de l'AD5940. */
&led0     { status = "disabled"; };
&led1     { status = "disabled"; };
&led2     { status = "disabled"; };
&led3     { status = "disabled"; };
&pwm_led0 { status = "disabled"; };
&button0  { status = "disabled"; };
&button1  { status = "disabled"; };
&button2  { status = "disabled"; };
&button3  { status = "disabled"; };

&gpio0 {
    /* Garder uniquement XL1/XL2 et NFC1/NFC2 réservés. */
    gpio-reserved-ranges = <0 2>, <9 2>;
};

/* ── SPI1 : AD5940 ──────────────────────────────────────────────────────── */
/* SCLK=P0.13  MOSI=P0.22  MISO=P0.15  CS=P0.17 (GPIO manuel, actif bas) */
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 22)>,
                    <NRF_PSEL(SPIM_MISO, 0, 15)>;
        };
    };
    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 22)>,
                    <NRF_PSEL(SPIM_MISO, 0, 15)>;
            low-power-enable;
            bias-pull-down;
        };
    };
};

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
};
